{
  "name": "wheelhouse",
  "version": "0.1.0",
  "description": "A desktop-class graphical interface for Claude Code. Runs locally in your browser or as a standalone window, with first-class right-to-left support.",
  "type": "module",
  "license": "MIT",
  "author": "msmahdinejad",
  "homepage": "https://github.com/msmahdinejad/wheelhouse#readme",
  "repository": { "type": "git", "url": "git+https://github.com/msmahdinejad/wheelhouse.git" },
  "bugs": { "url": "https://github.com/msmahdinejad/wheelhouse/issues" },
  "keywords": ["claude", "claude-code", "gui", "web-ui", "ai-coding", "agent", "rtl", "persian", "farsi", "i18n"],
  "bin": { "wheelhouse": "bin/wheelhouse.mjs" },
  "files": ["bin", "server", "web", "examples", "docs", "LICENSE", "README.md", "THIRD_PARTY_NOTICES.md"],
  "scripts": {
    "start": "node bin/wheelhouse.mjs",
    "dev": "node --watch server/index.mjs",
    "test": "node --test",
    "lint": "eslint .",
    "check": "npm run lint && npm test && npm run i18n:check",
    "i18n:check": "node scripts/extract-i18n.mjs --fail",
    "build:vendor": "node scripts/build-vendor.mjs"
  },
  "engines": { "node": ">=20" },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.309",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "dompurify": "^3.2.0",
    "esbuild": "^0.25.0",
    "eslint": "^9.0.0",
    "globals": "^15.0.0",
    "highlight.js": "^11.11.0",
    "marked": "^15.0.0",
    "puppeteer-core": "^24.0.0"
  }
}
